name: Docker Build

on:
  push:
    branches:
      - master
      - main
      - '0.2.0'
      - '0.*'
  pull_request:
    branches:
      - master
      - main
      - '0.2.0'

env:
  IMAGE_NAME: kizzasi

jobs:
  docker-build:
    name: Build Docker Image
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build image (no push — dry-run validation)
        uses: docker/build-push-action@v5
        with:
          context: .
          push: false
          tags: ${{ env.IMAGE_NAME }}:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          target: runtime

      - name: Confirm image tag
        run: |
          echo "Built image: ${{ env.IMAGE_NAME }}:${{ github.sha }}"
          docker images "${{ env.IMAGE_NAME }}:${{ github.sha }}" 2>/dev/null \
            || echo "Image exists in BuildKit cache (not loaded into daemon — expected for buildx)"
